n = (ARGV[0] || 27).to_i
q, r, t, k, next_digit, l = 1, 0, 1, 1, 3, 3
digits = +""
i = 1
while i <= n
  if 4 * q + r - t < next_digit * t
    digits << next_digit.to_s
    if i % 10 == 0 || i == n
      puts "#{digits.ljust(10)}\t:#{i}"
      digits.clear
    end
    nr = 10 * (r - next_digit * t)
    next_digit = (10 * (3 * q + r) / t) - 10 * next_digit
    q *= 10
    r = nr
    i += 1
  else
    nr = (2 * q + r) * l
    next_digit = (q * 7 * k + 2 + r * l) / (t * l)
    q *= k
    t *= l
    l += 2
    k += 1
    r = nr
  end
end
